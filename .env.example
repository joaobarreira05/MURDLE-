# Environment Variables — MURDOKU Faina DETI
# Copy this file to .env and fill in the values
# NEVER commit the actual .env file to git

# ─── Backend ─────────────────────────────────────────────────────────────────

# Secret key for JWT signing — generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-here-change-this

# Game access password — shared with players via Discord
GAME_ACCESS_PASSWORD=DETI2026

# Database URL
# SQLite (local development):
DATABASE_URL=sqlite+aiosqlite:///./murdoku.db
# PostgreSQL (Render production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Frontend URL for CORS (no trailing slash)
# Local development:
FRONTEND_URL=http://localhost:5173
# Production (your Render frontend URL):
# FRONTEND_URL=https://murdoku-frontend.onrender.com

# JWT token expiry in hours (default: 24)
ACCESS_TOKEN_EXPIRE_HOURS=24

# ─── Frontend ────────────────────────────────────────────────────────────────
# Put this in frontend/.env or frontend/.env.local

# Backend API URL (no trailing slash)
# Local development:
VITE_API_URL=http://localhost:8000
# Production (your Render backend URL):
# VITE_API_URL=https://murdoku-backend.onrender.com
